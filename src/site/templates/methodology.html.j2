    h2 { font-size: 1.3rem; margin-top: 0; border-bottom: 2px solid #e9ecef; padding-bottom: 0.5rem; }
    h3 { font-size: 1.05rem; color: #495057; }
    table { border-collapse: collapse; width: 100%; font-size: 0.9rem; margin: 1rem 0; }
    th, td { border: 1px solid #dee2e6; padding: 0.5rem 0.75rem; text-align: left; }
    th { background: #f1f3f5; }
    .caveat-list { list-style: none; padding: 0; }
    .caveat-list li { border-left: 4px solid #ffc107; padding: 0.5rem 0.75rem;
                      margin-bottom: 0.5rem; background: #fffbea; border-radius: 0 4px 4px 0;
